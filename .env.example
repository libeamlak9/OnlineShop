EXPO_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>
EXPO_PUBLIC_ADMIN_EMAIL=admin@example.com
EXPO_PUBLIC_ADMIN_PASSWORD=<your-admin-password>
EXPO_PUBLIC_ADMIN_TELEGRAM_USERNAME=admin_username

# Telegram channel sync (scripts/import-channel.js + telegram-webhook function)
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
TELEGRAM_API_ID=<from my.telegram.org>
TELEGRAM_API_HASH=<from my.telegram.org>
TELEGRAM_PHONE=<your telegram phone, e.g. +15551234567>
TELEGRAM_SESSION=<filled automatically after first login>
TELEGRAM_BOT_TOKEN=<from @BotFather>
TELEGRAM_CHANNEL=@yourchannel
ADMIN_TELEGRAM_CHAT_ID=<numeric id; run scripts/get-chat-id.js>
WEBHOOK_SECRET=<random string used to verify webhook calls>
# Only needed if Telegram is blocked on your network (local scripts):
TELEGRAM_PROXY=http://127.0.0.1:7890

# AI product naming (scripts/suggest-names.js)
SUPABASE_ACCESS_TOKEN=<personal access token from supabase.com/dashboard/account/tokens>
MOONSHOT_API_KEY=<from platform.moonshot.cn>
